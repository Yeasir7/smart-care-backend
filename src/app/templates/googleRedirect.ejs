<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Google Login</title>
</head>
<body>
    <div>
        <p>Redirecting To Google...</p>
    </div>
</body>
<script>
    (
        async () => {
            try {
                const response = await fetch("<%= betterAuthUrl %>/api/auth/sign-in/social", {
                    method : "POST",
                    headers : {
                        "Content-Type" : "application/json"
                    },
                    credentials : "include",
                    body: JSON.stringify({
                        provider : "google",
                        callbackURL: "<%= callbackURL %>"
                    })
                })

                const data = await response.json();

                if(data && data.url){
                    window.location.href = data.url;
                }else{
                    const errMsg = (data && (data.message || data.error)) || "Unable to initialize Google Sign-in. Please try again.";
                    document.body.innerHTML = `<div>
                    <p style="color: red; font-family: sans-serif;">${errMsg}</p>
                    <p><a href="<%= betterAuthUrl %>/api/v1/auth/login/google" style="font-family: sans-serif;">Try Again</a></p>
                    </div>`;
                }
            } catch (error) {
                document.body.innerHTML = `<div>
                    <p style="color: red; font-family: sans-serif;">${error.message}</p>
                    <p><a href="<%= betterAuthUrl %>/api/v1/auth/login/google" style="font-family: sans-serif;">Try Again</a></p>
                    </div>`;
            }
        }
    )()
</script>
</html>